@article{gao2025jmp,
title = {Unseen Nexus: Institutional Equity Investors and Corporate Debt Financing},
abstract = {Institutional equity investors shape corporate debt issuance due to their triple role as firm shareholders, key participants in the equity market, and informational conduits to the debt market.
Among US non-financial public firms, a five percentage point increase in institutional equity shareholdings is associated with a 21% rise in debt issuance.
Two novel mechanisms, information transmission and equity benchmarking from institutional equity investors, contribute to this relationship. I provide causal evidence by leveraging a regulatory change in mutual fund disclosure and variation in equity index benchmarking intensity as instrumental variable respectively.
A general equilibrium model is developed in which equity investors, debt investors, and the firm interact, accounting for information transmission and benchmarking behavior.
Counterfactual analyses show that eliminating the information channel reduces the magnitude of the relationship between debt issuance and institutional equity shareholdings by more than one-fifth.
These findings highlight the importance of cross-market linkages and firms’ responses to investor characteristics in understanding equilibrium financing outcomes, an aspect not well understood by existing literature.},
additional_info = {MRS 2025 (CIRF & CFRI) (scheduled), 5th COAP 2025 (scheduled), FMA Doctoral Student Consortium 2025 (scheduled) and Special PhD Paper Presentations, SFA 2025 (scheduled)}
}
# The model matches key moments on debt and equity issuance, institutional ownership, and how firm financing responds to institutional ownership.
