@article{gao2025jmp,
title = {Bridging Markets: Equity Investors' Dual Roles in Corporate Debt Financing (Job market paper)},
abstract = {I demonstrate that institutional equity investors influence corporate debt financing through their dual roles as informed traders and shareholders.
These roles operate through two distinct channels: an information transmission channel, where institutional equity investors transmit information to debt investors, 
and a benchmarking channel, where investors' benchmarking mandates alter the discount factors used to value firm cash flows. Empirically, 
I provide causal evidence for both channels by exploiting a mutual fund disclosure reform and using equity benchmarking intensity as an instrument. 
Theoretically, I develop a dynamic general equilibrium model that incorporates both channels and endogenizes firms' financing choices and investors' shareholdings. 
I show that the information channel accounts for over 20% of the observed relationship between institutional ownership and corporate debt issuance, with the associated 
information costs amounting to roughly 5% of equity value. Furthermore, an increase in benchmarking intensity comparable to Russell 2000 inclusion amplifies the relationship by 9%. 
These results highlight the importance of cross-market investor linkages and firm responses to investor characteristics in understanding financing outcomes.},
additional_info = {MRS 2025 (CIRF & CFRI), COAP 2025 (Luxembourg), FMA Doctoral Student Consortium 2025 and Special PhD Paper Presentations (scheduled), SFA 2025 (scheduled), AFA poster session 2026 (scheduled)}
}
