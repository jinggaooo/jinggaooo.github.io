@article{gao2025jmp,
title = {Unseen Financing Nexus: The Role of Institutional Equity Investors in Corporate Debt Financing (Job market paper)},
abstract = {Institutional equity investors significantly influence corporate debt issuance through their triple role as shareholders, equity market participants, and informational intermediaries to the debt market.
Among U.S. non-financial public firms, a five-percentage-point increase in institutional equity ownership is associated with a 22% rise in debt issuance.
Two novel mechanisms contribute to this relationship through debt capital supply and demand respectively: information transmission and equity benchmarking.
Causal evidence is established using a regulatory shock to mutual fund disclosure and cross-sectional variation in equity index benchmarking intensity as instrumental variables.
To understand these findings, I calibrate a general equilibrium model incorporating interactions among equity investors, debt investors, and firms, featuring information transmission and benchmarking.
The information channel accounts for over one-fifth of the debt-equity holdings relationship, while the associated informational frictions in debt issuance represent approximately 1% of equity value.
In addition, a change in benchmarking intensity comparable to the addition to Russell 2000 increases the debt-equity holdings relationship by 9%.
These results underscore the importance of cross-market investor linkages and firm responses to investor heterogeneity in shaping financing outcomes—a dimension overlooked by prior literature.},
additional_info = {MRS 2025 (CIRF & CFRI) (scheduled), 5th COAP 2025 (scheduled), FMA Doctoral Student Consortium 2025 (scheduled) and Special PhD Paper Presentations, SFA 2025 (scheduled)}
}
# The model matches key moments on debt and equity issuance, institutional ownership, and how firm financing responds to institutional ownership.
