@article{gao2025jmp,
title = {Institutional Equity Investors and Corporate Debt Financing: A Cross-Market Perspective (Job market paper)},
abstract = {Institutional equity investors significantly influence corporate debt issuance due to their triple role as shareholders, equity market participants, 
and informational intermediaries to the debt market. Among U.S. non-financial public firms, a five-percentage-point increase in institutional equity ownership 
is associated with a 22% rise in debt issuance. This paper focuses on two mechanisms contributing to this relationship: a supply-side information channel where debt investors 
learn from equity investors, and a demand-side benchmarking channel that affects shareholders' effective risk aversion. Causal evidence is established using 
a regulatory shock to mutual fund disclosure and equity benchmarking intensity as an instrumental variable. A calibrated model featuring both mechanisms 
reveals that the information channel accounts for roughly one-fifth of the debt-equity holdings relationship, with the informational frictions in debt 
issuance representing about 1% of equity value. Additionally, a benchmarking-induced increase in institutional ownership comparable to Russell 2000 inclusion 
amplifies the relationship by 9%. These results highlight the importance of cross-market investor linkages and firm responses to investor characteristics in 
understanding financing outcomes.},
additional_info = {MRS 2025 (CIRF & CFRI), COAP 2025 (Luxembourg), FMA Doctoral Student Consortium 2025 and Special PhD Paper Presentations (scheduled), SFA 2025 (scheduled)}
}
# The model matches key moments on debt and equity issuance, institutional ownership, and how firm financing responds to institutional ownership.
