@article{gao2025jmp,
title = {Bridging Markets: The Role of Institutional Equity Investors in Corporate Debt Financing (Job market paper)},
abstract = {Institutional equity investors significantly influence corporate debt issuance due to their triple role as shareholders, equity market participants, 
and informational intermediaries to the debt market. Among U.S. non-financial public firms, a five-percentage-point increase in institutional 
equity ownership is associated with a 22% rise in debt issuance. Two novel mechanisms contribute to this relationship: a supply-side information channel 
where debt investors learn from equity investors, and a demand-side benchmarking channel that affects shareholders' effective risk aversion.
Causal evidence is established using a regulatory shock to mutual fund disclosure and equity benchmarking intensity as 
instrumental variables. A calibrated model featuring both mechanisms reveals that the information channel accounts for roughly one-fifth of the debt-equity holdings 
relationship, with the informational frictions in debt issuance representing roughly 1% of equity value. Additionally, a benchmarking-induced increase in ownership
comparable to Russell 2000 inclusion amplifies the relationship by 9%. 
These results highlight the importance of cross-market investor linkages and firm responses to 
investor characteristics in shaping financing outcomes.},
additional_info = {MRS 2025 (CIRF & CFRI) (scheduled), 5th COAP 2025 (scheduled), FMA Doctoral Student Consortium 2025 (scheduled) and Special PhD Paper Presentations, SFA 2025 (scheduled)}
}
# The model matches key moments on debt and equity issuance, institutional ownership, and how firm financing responds to institutional ownership.
